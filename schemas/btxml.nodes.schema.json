{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BtxmlNodes",
  "description": "Node definition schema for btxml projects.",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["Action", "Condition", "Control", "Decorator", "SubTree"]
          },
          "ports": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "enum": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "required": {
                  "type": "boolean"
                },
                "default": {
                  "type": "string"
                },
                "direction": {
                  "type": "string",
                  "enum": ["input", "output", "inout"]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "required": ["kind"],
        "additionalProperties": false
      }
    }
  },
  "required": ["nodes"],
  "additionalProperties": false
}
