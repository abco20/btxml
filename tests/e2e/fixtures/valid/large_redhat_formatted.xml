<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree"><BehaviorTree ID="MainTree"><Sequence><Fallback><Condition ID="IsBatteryLevelOK" threshold="20.0" topic="/battery/status"/><Action ID="NavigateToChargingStation" station_id="home_base" max_velocity="0.5"/></Fallback><Parallel success_count="2" failure_count="1"><Sequence><Action ID="MoveArm" joint_positions="{arm_target}" velocity="0.3" acceleration="0.1"/><Action ID="GripperControl" position="0.05" force="10.0" object="{detected_object}"/></Sequence><Sequence><Decorator ID="Timeout" ms="5000"><Action ID="MoveBase" goal="{nav_goal}" frame_id="map" tolerance="0.1"/></Decorator><SubTree ID="PerceptionPipeline" camera_topic="/camera/color/image_raw" model_path="{perception_model}"/></Sequence></Parallel><Control ID="ReactiveSequence"><Condition ID="IsPathClear" min_distance="0.5" sensor_topic="/scan"/><Action ID="PublishVelocity" linear_x="{desired_velocity}" angular_z="0.0" topic="/cmd_vel"/></Control></Sequence></BehaviorTree><BehaviorTree ID="PerceptionPipeline"><Sequence><Action ID="StartCamera" topic="{camera_topic}" width="640" height="480" fps="30"/><RetryUntilSuccessful num_attempts="3"><Fallback><Condition ID="ObjectDetected" confidence="0.85" class_filter="{object_class}"/><Action ID="AdjustCameraPose" pan="{pan_angle}" tilt="{tilt_angle}"/></Fallback></RetryUntilSuccessful><Action ID="RunInference" model="{model_path}" device="GPU" batch_size="1"/></Sequence></BehaviorTree><BehaviorTree ID="SafetyMonitor"><ReactiveFallback><Condition ID="IsEmergencyStopPressed" topic="/estop/status"/><Sequence><Action ID="StopAllMotion" deceleration="2.0"/><Action ID="SetLEDColor" color="red" pattern="solid" duration_ms="1000"/></Sequence></ReactiveFallback></BehaviorTree><TreeNodesModel><Action ID="MoveBase"><input_port name="goal" type="Pose2D">Target pose in 2D</input_port><input_port name="frame_id" type="std::string">Reference frame</input_port><input_port name="tolerance" default="0.1" type="double">Position tolerance</input_port></Action><Action ID="MoveArm"><input_port name="joint_positions" type="std::vector&lt;double&gt;">Target joint configuration</input_port><input_port name="velocity" default="0.5" type="double">Max joint velocity</input_port><input_port name="acceleration" default="0.2" type="double">Max joint acceleration</input_port></Action><Action ID="GripperControl"><input_port name="position" type="double">Gripper aperture</input_port><input_port name="force" default="5.0" type="double">Grasp force</input_port><input_port name="object" type="std::string">Object identifier</input_port></Action><Condition ID="IsBatteryLevelOK"><input_port name="threshold" type="double">Minimum acceptable percentage</input_port><input_port name="topic" default="/battery/status" type="std::string">Battery topic</input_port></Condition><Condition ID="IsPathClear"><input_port name="min_distance" default="0.3" type="double">Minimum obstacle distance</input_port><input_port name="sensor_topic" type="std::string">Laser scan topic</input_port></Condition><Decorator ID="Timeout"><input_port name="ms" type="int">Timeout in milliseconds</input_port></Decorator><Control ID="ReactiveSequence"/><Control ID="ReactiveFallback"/><Control ID="Parallel"><input_port name="success_count" type="int">Required successes</input_port><input_port name="failure_count" type="int">Allowed failures</input_port></Control><SubTree ID="PerceptionPipeline"><input_port name="camera_topic" type="std::string">RGB camera topic</input_port><input_port name="model_path" type="std::string">ONNX model path</input_port></SubTree></TreeNodesModel></root>
